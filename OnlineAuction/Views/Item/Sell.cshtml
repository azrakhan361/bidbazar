@model SellItemViewModel
@{
    ViewData["Title"] = "Sell an Item";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <h3 class="fw-bold mb-4"><i class="fas fa-tag" style="color:var(--accent)"></i> List an Item for Sale</h3>
            <form asp-action="Sell" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Samsung Galaxy S24" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe your item..."></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-image text-primary"></i> Upload Image
                        </label>
                        <input asp-for="Image" type="file" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            <i class="fas fa-file-word text-primary"></i> Upload Document
                        </label>
                        <input asp-for="Document" type="file" class="form-control"
                               accept=".doc,.docx,.pdf,.txt" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MinimumBid" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">PKR</span>
                            <input asp-for="MinimumBid" class="form-control" placeholder="500" />
                        </div>
                        <span asp-validation-for="MinimumBid" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="BidIncrement" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">PKR</span>
                            <input asp-for="BidIncrement" class="form-control" placeholder="100" />
                        </div>
                        <span asp-validation-for="BidIncrement" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="BidEndDate" class="form-label fw-semibold"></label>
                        <input asp-for="BidEndDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="BidEndDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select"
                                asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-accent px-5">
                            <i class="fas fa-upload"></i> List Item
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
