@{
    ViewData["Title"] = "Seller Profile";
    var seller = (ApplicationUser)ViewBag.Seller;
    var ratings = (List<Rating>)ViewBag.Ratings;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4 text-center mb-4">
            <i class="fas fa-user-circle fa-5x text-secondary mb-3"></i>
            <h4 class="fw-bold">@seller.FullName</h4>
            <p class="text-muted">@seller.Email</p>
            <p>
                <span class="badge bg-warning text-dark fs-6">
                    ★ Cumulative Rating: @seller.CumulativeRating
                </span>
            </p>
            <p class="text-muted small">Member since @seller.RegisteredAt.ToString("MMM yyyy")</p>
        </div>

        <h5 class="fw-bold mb-3">Reviews (@ratings.Count)</h5>
        @if (!ratings.Any())
        {
            <p class="text-muted">No reviews yet.</p>
        }
        else
        {
            @foreach (var r in ratings)
            {
                <div class="card mb-2 p-3">
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">@r.Rater?.FullName</span>
                        <span class="badge @(r.Score >= 0 ? "bg-success" : "bg-danger")">
                            @(r.Score >= 0 ? "+" : "")@r.Score
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(r.Comment))
                    {
                        <p class="text-muted small mb-0 mt-1">@r.Comment</p>
                    }
                    <small class="text-muted">@r.RatedAt.ToString("dd MMM yyyy")</small>
                </div>
            }
        }
    </div>
</div>
