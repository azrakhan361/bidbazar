@{
    ViewData["Title"] = "Edit Item";
    var item = (Item)ViewBag.Item;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card p-4">
            <h4 class="fw-bold mb-4"><i class="fas fa-edit"></i> Edit: @item.Title</h4>
            <form asp-action="Edit" asp-route-id="@item.ItemId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-image text-primary"></i> Upload New Image
                    </label>
                    @if (item.ImagePath != null)
                    {
                        <div class="mb-2">
                            <img src="@item.ImagePath" style="height:80px;border-radius:8px;" />
                            <small class="text-muted ms-2">Current image</small>
                        </div>
                    }
                    <input name="newImage" type="file" class="form-control" accept="image/*" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-file-word text-primary"></i> Upload New Document
                    </label>
                    @if (item.DocumentPath != null)
                    {
                        <div class="mb-2">
                            <a href="@item.DocumentPath" download>
                                <i class="fas fa-file"></i> Existing document
                            </a>
                        </div>
                    }
                    <input name="newDocument" type="file" class="form-control"
                           accept=".doc,.docx,.pdf,.txt" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bid Increment (PKR)</label>
                    <input name="bidIncrement" type="number" class="form-control"
                           value="@item.BidIncrement" min="1" required />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@item.ItemId"
                       class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
