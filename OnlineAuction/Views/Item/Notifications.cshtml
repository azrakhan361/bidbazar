@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h3 class="fw-bold mb-4">
    <i class="fas fa-bell text-warning"></i> Notifications
</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">You have no notifications.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <div class="list-group-item @(!n.IsRead ? "list-group-item-warning" : "")">
                <div class="d-flex justify-content-between">
                    <span><i class="fas fa-bell me-2 text-warning"></i>@n.Message</span>
                    <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                </div>
            </div>
        }
    </div>
}
