@model List<Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between mb-4">
    <h4 class="fw-bold"><i class="fas fa-tags"></i> Categories</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back</a>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card p-3">
            <h6 class="fw-bold mb-3">Add New Category</h6>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <input name="name" class="form-control" placeholder="Category name" required maxlength="100" />
                </div>
                <div class="mb-2">
                    <input name="description" class="form-control" placeholder="Description (optional)" />
                </div>
                <button type="submit" class="btn btn-success w-100">
                    <i class="fas fa-plus"></i> Create Category
                </button>
            </form>
        </div>
        <div class="mt-3">
            <a asp-action="MergeCategory" class="btn btn-warning w-100">
                <i class="fas fa-compress-alt"></i> Merge Categories
            </a>
        </div>
    </div>

    <div class="col-md-7">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Items for Sale</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cat.Name</td>
                            <td class="text-muted small">@cat.Description</td>
                            <td>
                                <span class="badge bg-primary">
                                    @cat.Items.Count(i => i.BidStatus == 'A')
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
