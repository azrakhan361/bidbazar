@* Views/Admin/Index.cshtml *@
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h3 class="fw-bold mb-4">
    <i class="fas fa-shield-alt text-warning"></i> Admin Dashboard
</h3>

<div class="row g-3 mb-5">
    <div class="col-md-3">
        <div class="card text-center p-3 border-primary">
            <h2 class="fw-bold text-primary">@ViewBag.TotalUsers</h2>
            <p class="text-muted mb-0">Total Users</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-danger">
            <h2 class="fw-bold text-danger">@ViewBag.BlockedUsers</h2>
            <p class="text-muted mb-0">Blocked Users</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-success">
            <h2 class="fw-bold text-success">@ViewBag.ActiveItems</h2>
            <p class="text-muted mb-0">Active Auctions</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center p-3 border-warning">
            <h2 class="fw-bold text-warning">@ViewBag.TotalCategories</h2>
            <p class="text-muted mb-0">Categories</p>
        </div>
    </div>
</div>

<div class="d-flex gap-3 flex-wrap">
    <a asp-action="Users" class="btn btn-outline-primary">
        <i class="fas fa-users"></i> Manage Users
    </a>
    <a asp-action="Categories" class="btn btn-outline-success">
        <i class="fas fa-tags"></i> Manage Categories
    </a>
    <a asp-action="Items" class="btn btn-outline-secondary">
        <i class="fas fa-list"></i> All Items
    </a>
    <a asp-action="MergeCategory" class="btn btn-outline-warning">
        <i class="fas fa-compress-alt"></i> Merge Categories
    </a>
</div>
